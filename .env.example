# Server-only mail settings for Hostinger (or any SMTP provider).
# NEVER prefix these with VITE_ — that would expose them to the browser.
#
# Copy this file to `.env.local` and fill in your Hostinger values:
#   cp .env.example .env.local
#
# Hostinger SMTP (typical):
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465   (SSL)  or  587 (TLS)
#   SMTP_USER=info@hayth-ai.com
#   SMTP_PASS=<your Hostinger email password or app password>
#   MAIL_FROM=info@hayth-ai.com
#   MAIL_TO=info@hayth-ai.com
#
# Leave MAIL_TRANSPORT=json for local testing without sending real email.
# Remove MAIL_TRANSPORT (or leave it blank) when SMTP is configured for production.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=info@hayth-ai.com
MAIL_TO=info@hayth-ai.com
MAIL_TRANSPORT=json
